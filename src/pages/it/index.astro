---
import Base from '../../layouts/Base.astro';
import { homePhrases, getRandomItem } from '../../data/it/phrases';
---

<Base title="Home">
  <div class="marquee">
    <span class="marquee-text">
      💼 BENVENUTO NELLA ZONA DI SOPRAVVIVENZA LAVORATIVA — QUI NON SI PRODUTTIVIZZA — QUI SI SOPRAVVIVE 💼
    </span>
  </div>

  <div class="home-hero">
    <h1>💼 SOPRAVVIVENZA LAVORATIVA</h1>
    <p class="hero-subtitle">Il sito per gente che è stanchissima di lavorare</p>
    <p class="hero-phrase">{getRandomItem(homePhrases)}</p>
  </div>

  <div class="tools-grid">
    <a href="/it/quanto-mancano-stipendio" class="tool-card">
      <div class="tool-icon">💰</div>
      <h2>QUANTO MANCA PER LO STIPENDIO?</h2>
      <p>Calcola quanti giorni, ore e minuti mancano al tuo prossimo stipendio.</p>
    </a>

    <a href="/it/quanto-mancano-venerdi" class="tool-card">
      <div class="tool-icon">🎉</div>
      <h2>QUANTO MANCA AL VENERDÌ?</h2>
      <p>Il conto alla rovescia definitivo per sapere quanto sofferenza manca.</p>
    </a>

    <a href="/it/calcolatrice-vita" class="tool-card">
      <div class="tool-icon">⚖️</div>
      <h2>VITA vs STIPENDIO</h2>
      <p>Quanto vale davvero la tua vita lavorativa? Scoprilo con dolore.</p>
    </a>

    <a href="/it/calcolatrice-pensione" class="tool-card">
      <div class="tool-icon">🏖️</div>
      <h2>CALCOLATRICE PENSIONE</h2>
      <p>Quanto tempo manca di schiavitù... intendiamo, di lavoro.</p>
    </a>

    <a href="/it/libro-firme" class="tool-card">
      <div class="tool-icon">✍️</div>
      <h2>LIBRO DELLE FIRME</h2>
      <p>Firma per i tuoi diritti. O per qualunque cosa. Qui si firma per tutto.</p>
    </a>

    <a href="/it/colpisci-il-props" class="tool-card">
      <div class="tool-icon">👊</div>
      <h2>COLPISCI IL BOSS</h2>
      <p>Un minigioco per liberare tutta la rabbia accumulata da lunedì a giovedì.</p>
    </a>
  </div>
</Base>

<style>
  .home-hero {
    text-align: center;
    padding: 3rem 1rem;
    border-bottom: 3px dashed var(--color-primary);
    margin-bottom: 2rem;
  }

  .home-hero h1 {
    font-size: 2.5rem;
    color: var(--color-secondary);
    text-shadow: 3px 3px 0 var(--color-primary);
    margin-bottom: 1rem;
  }

  .hero-subtitle {
    font-size: 1.2rem;
    color: var(--color-text-muted);
    margin-bottom: 1rem;
  }

  .hero-phrase {
    font-style: italic;
    color: var(--color-accent);
    font-size: 1.1rem;
  }

  .tools-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
    margin-bottom: 2rem;
  }

  .tool-card {
    background: var(--color-card-bg);
    border: 2px solid var(--color-card-border);
    padding: 1.5rem;
    text-decoration: none;
    color: inherit;
    transition: all 0.3s;
  }

  .tool-card:hover {
    border-color: var(--color-primary);
    transform: translateY(-5px);
    box-shadow: 0 10px 30px rgba(255, 107, 53, 0.3);
    text-decoration: none;
  }

  .tool-icon {
    font-size: 2.5rem;
    margin-bottom: 1rem;
  }

  .tool-card h2 {
    font-size: 1rem;
    margin-bottom: 0.5rem;
    color: var(--color-primary);
  }

  .tool-card p {
    font-size: 0.9rem;
    color: var(--color-text-muted);
  }

  .marquee {
    margin-top: 2rem;
  }
</style>
