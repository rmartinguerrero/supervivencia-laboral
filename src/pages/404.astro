---
// Funny 404 page - detects language from URL
const url = Astro.url.pathname;
const lang = url.startsWith('/it') ? 'it' : 'es';
---

<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{lang === 'es' ? '404 - Página perdida como tu motivación' : '404 - Pagina persa come la tua motivazione'}</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Press+Start+2P&family=VT323&display=swap');

    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      min-height: 100vh;
      background: #0d0221;
      color: #e0e0e0;
      font-family: 'VT323', monospace;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 2rem;
      overflow-x: hidden;
    }

    .glitch-container {
      position: relative;
      margin-bottom: 2rem;
    }

    .error-code {
      font-family: 'Press Start 2P', cursive;
      font-size: 8rem;
      color: #ff6b35;
      text-shadow:
        3px 3px 0 #f7c948,
        -2px -2px 0 #e84393;
      animation: glitch 2s infinite;
      position: relative;
    }

    .error-code::before,
    .error-code::after {
      content: '404';
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
    }

    .error-code::before {
      color: #e84393;
      animation: glitch-1 0.3s infinite;
      clip-path: polygon(0 0, 100% 0, 100% 45%, 0 45%);
    }

    .error-code::after {
      color: #00b894;
      animation: glitch-2 0.3s infinite;
      clip-path: polygon(0 55%, 100% 55%, 100% 100%, 0 100%);
    }

    @keyframes glitch {
      0%, 90%, 100% { transform: none; }
      91% { transform: skewX(-2deg); }
      93% { transform: skewX(2deg); }
      95% { transform: skewX(-1deg); }
    }

    @keyframes glitch-1 {
      0%, 100% { transform: translate(0); }
      20% { transform: translate(-3px, 3px); }
      40% { transform: translate(3px, -3px); }
      60% { transform: translate(-2px, 1px); }
      80% { transform: translate(2px, -1px); }
    }

    @keyframes glitch-2 {
      0%, 100% { transform: translate(0); }
      20% { transform: translate(3px, -3px); }
      40% { transform: translate(-3px, 3px); }
      60% { transform: translate(2px, -1px); }
      80% { transform: translate(-2px, 1px); }
    }

    .sad-emoji {
      font-size: 5rem;
      margin: 1rem 0;
      animation: float 3s ease-in-out infinite;
    }

    @keyframes float {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(-15px); }
    }

    .message {
      font-size: 1.5rem;
      color: #f7c948;
      margin-bottom: 0.5rem;
      max-width: 600px;
      line-height: 1.4;
    }

    .sub-message {
      font-size: 1.1rem;
      color: #888;
      margin-bottom: 2rem;
      max-width: 500px;
      line-height: 1.3;
    }

    .excuse-list {
      list-style: none;
      margin: 1.5rem 0;
      padding: 0;
    }

    .excuse-list li {
      font-size: 1rem;
      color: #e84393;
      margin: 0.4rem 0;
      opacity: 0;
      animation: fadeIn 0.5s forwards;
    }

    .excuse-list li:nth-child(1) { animation-delay: 0.3s; }
    .excuse-list li:nth-child(2) { animation-delay: 0.6s; }
    .excuse-list li:nth-child(3) { animation-delay: 0.9s; }
    .excuse-list li:nth-child(4) { animation-delay: 1.2s; }

    @keyframes fadeIn {
      to { opacity: 1; }
    }

    .home-btn {
      display: inline-block;
      margin-top: 1.5rem;
      padding: 1rem 2rem;
      font-family: 'Press Start 2P', cursive;
      font-size: 0.8rem;
      color: #0d0221;
      background: #f7c948;
      border: none;
      cursor: pointer;
      text-decoration: none;
      transition: all 0.2s;
      animation: blink-border 1.5s infinite;
    }

    .home-btn:hover {
      background: #ff6b35;
      color: white;
      transform: scale(1.05);
      text-decoration: none;
    }

    @keyframes blink-border {
      0%, 100% { box-shadow: 0 0 0 0 rgba(247, 201, 72, 0.4); }
      50% { box-shadow: 0 0 20px 5px rgba(247, 201, 72, 0.3); }
    }

    .marquee {
      margin-top: 2rem;
      overflow: hidden;
      width: 100%;
      max-width: 600px;
    }

    .marquee-text {
      display: inline-block;
      white-space: nowrap;
      font-size: 0.8rem;
      color: #00b894;
      animation: scroll 15s linear infinite;
    }

    @keyframes scroll {
      0% { transform: translateX(100%); }
      100% { transform: translateX(-100%); }
    }

    .ascii-art {
      font-size: 0.6rem;
      color: #ff6b35;
      line-height: 1.1;
      margin: 1rem 0;
      white-space: pre;
    }

    @media (max-width: 600px) {
      .error-code { font-size: 4rem; }
      .sad-emoji { font-size: 3rem; }
      .message { font-size: 1.2rem; }
    }
  </style>
</head>
<body>
  <div class="glitch-container">
    <div class="error-code">404</div>
  </div>

  <div class="sad-emoji">😵</div>

  {lang === 'es' ? (
    <>
      <h1 class="message">ESTA PÁGINA NO EXISTE</h1>
      <p class="sub-message">Como las vacaciones pagadas de tu empresa. Es decir, no están.</p>

      <ul class="excuse-list">
        <li>🔍 La página fue despedida por bajo rendimiento</li>
        <li>📋 Está en una reunión que podría haber sido un email</li>
        <li>☕ Está en una pausa de café que lleva 3 horas</li>
        <li>📧 Le llegaron 47 emails y colapsó</li>
      </ul>


      <a href="/es" class="home-btn">VOLVER AL DESPACHO</a>

      <div class="marquee">
        <span class="marquee-text">
          ★ Trabaja menos, respira más ★ La vida es corta para estar en reuniones ★ Si no hay café, no hay código ★ El viernes también existe ★
        </span>
      </div>
    </>
  ) : (
    <>
      <h1 class="message">QUESTA PAGINA NON ESISTE</h1>
      <p class="sub-message">Come le vacanze retribuite della tua azienda. Cioè, non ci sono.</p>

      <ul class="excuse-list">
        <li>🔍 La pagina è stata licenziata per scarso rendimento</li>
        <li>📋 È in una riunione che poteva essere un'email</li>
        <li>☕ È in pausa caffè da 3 ore</li>
        <li>📧 Ha ricevuto 47 email e è crollata</li>
      </ul>

      <a href="/it" class="home-btn">TORNA IN UFFICIO</a>

      <div class="marquee">
        <span class="marquee-text">
          ★ Lavora di meno, respira di più ★ La vita è troppo breve per le riunioni ★ Se non c'è caffè, non c'è codice ★ Anche il venerdì esiste ★
        </span>
      </div>
    </>
  )}
</body>
</html>
