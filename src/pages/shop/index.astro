---
import Base from '../../layouts/Base.astro';
---

<Base title="Tienda - Próximamente">
  <div class="shop-placeholder">
    <div class="under-construction">
      ⚠ EN CONSTRUCCIÓN ⚠
    </div>

    <h1>PRÓXIMAMENTE</h1>
    <p class="shop-subtitle">Estamos preparando algo absurdo para ti.</p>

    <div class="coming-soon">
      <div class="shop-item">
        <span className="item-icon">👕</span>
        <p>Camisetas con frases</p>
      </div>
      <div className="shop-item">
        <span className="item-icon">🏷️</span>
        <p>Pegatinas</p>
      </div>
      <div className="shop-item">
        <span className="item-icon">☕</span>
        <p>Tazas desmotivacionales</p>
      </div>
      <div className="shop-item">
        <span className="item-icon">📦</span>
        <p>Kits de supervivencia laboral</p>
      </div>
    </div>

    <p class="shop-phrase">"No estoy cansado. Estoy empleado."</p>
    <p class="shop-phrase">"Esta reunión podía ser un email."</p>
    <p class="shop-phrase">"Firmo por trabajar 4 días."</p>

    <div class="under-construction" style="margin-top: 2rem;">
      ⚠ PRÓXIMAMENTE — NO SOMOS UNA STARTUP ⚠
    </div>
  </div>
</Base>

<style>
  .shop-placeholder {
    text-align: center;
    padding: 3rem 1rem;
  }

  .shop-placeholder h1 {
    font-size: 3rem;
    color: var(--color-secondary);
    text-shadow: 3px 3px 0 var(--color-primary);
    margin: 2rem 0 1rem;
  }

  .shop-subtitle {
    font-size: 1.2rem;
    color: var(--color-text-muted);
    margin-bottom: 2rem;
  }

  .coming-soon {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1.5rem;
    max-width: 800px;
    margin: 0 auto 2rem;
  }

  .shop-item {
    background: var(--color-card-bg);
    border: 2px dashed var(--color-card-border);
    padding: 1.5rem;
    opacity: 0.7;
  }

  .item-icon {
    font-size: 2rem;
    display: block;
    margin-bottom: 0.5rem;
  }

  .shop-item p {
    color: var(--color-text-muted);
  }

  .shop-phrase {
    font-style: italic;
    color: var(--color-accent);
    margin: 0.5rem 0;
    font-size: 0.95rem;
  }
</style>
