---
import { translatePath } from '../utils/slugs';

const lang = Astro.currentLocale || 'es';

const navItems = lang === 'es' ? [
  { slug: '', label: 'INICIO' },
  { slug: 'cuanto-falta-cobrar', label: '¿CUÁNTO FALTA?' },
  { slug: 'cuanto-falta-viernes', label: 'VIERNES' },
  { slug: 'calculadora-vida', label: 'VIDA vs SALARIO' },
  { slug: 'calculadora-jubilacion', label: 'JUBILACIÓN' },
  { slug: 'libro-firmas', label: 'LIBRO DE FIRMAS' },
  { slug: 'pega-al-jefe', label: 'PEGA AL JEFE' },
] : [
  { slug: '', label: 'HOME' },
  { slug: 'quanto-mancano-stipendio', label: 'QUANTO MANCA?' },
  { slug: 'quanto-mancano-venerdi', label: 'VENERDÌ' },
  { slug: 'calcolatrice-vita', label: 'VITA vs STIPENDIO' },
  { slug: 'calcolatrice-pensione', label: 'PENSIONE' },
  { slug: 'libro-firme', label: 'LIBRO DELLE FIRME' },
  { slug: 'colpisci-il-boss', label: 'COLPISCI IL BOSS' },
];

const otherLang = lang === 'es' ? 'it' : 'es';
const otherLangLabel = lang === 'es' ? '🇮🇹 IT' : '🇪🇸 ES';
const currentPath = Astro.url.pathname;

// Build translated path for language switcher
const otherLangPath = translatePath(currentPath, otherLang);
---

<nav class="retro-nav">
  <div class="nav-container">
    <a href={`/${lang}`} class="nav-logo">
      💼 {lang === 'es' ? 'SUPERVIVENCIA LABORAL' : 'SOPRAVVIVENZA LAVORATIVA'}
    </a>

    <div class="nav-links">
      {navItems.map(item => {
        const href = `/${lang}${item.slug ? '/' + item.slug : ''}`;
        const isActive = currentPath === href || currentPath === href + '/';
        return (
          <a href={href} class:list={['nav-link', { active: isActive }]}>
            {item.label}
          </a>
        );
      })}
      <a href={otherLangPath} class="nav-link lang-switch">
        {otherLangLabel}
      </a>
      <span class="theme-switch">
        <span class="theme-switch-label">THEME:</span>
        <button class="theme-switch-btn active" data-theme-value="normal">NORMAL</button>
        <button class="theme-switch-btn" data-theme-value="80s-office">80s</button>
      </span>
    </div>

    <button class="hamburger" aria-label="Menu" aria-expanded="false">
      <span class="hamburger-line"></span>
      <span class="hamburger-line"></span>
      <span class="hamburger-line"></span>
    </button>
  </div>

  <div class="nav-overlay"></div>
</nav>

<script>
  function initNav() {
    const hamburger = document.querySelector('.hamburger');
    const navLinks = document.querySelector('.nav-links');
    const overlay = document.querySelector('.nav-overlay');
    if (!hamburger || !navLinks || !overlay) return;

    hamburger.addEventListener('click', () => {
      const open = navLinks.classList.toggle('open');
      hamburger.classList.toggle('open');
      overlay.classList.toggle('open');
      hamburger.setAttribute('aria-expanded', String(open));
    });

    overlay.addEventListener('click', () => {
      navLinks.classList.remove('open');
      hamburger.classList.remove('open');
      overlay.classList.remove('open');
      hamburger.setAttribute('aria-expanded', 'false');
    });

    navLinks.querySelectorAll('.nav-link').forEach(link => {
      link.addEventListener('click', () => {
        navLinks.classList.remove('open');
        hamburger.classList.remove('open');
        overlay.classList.remove('open');
        hamburger.setAttribute('aria-expanded', 'false');
      });
    });
  }

  function initTheme() {
    const btns = document.querySelectorAll('.theme-switch-btn');
    if (!btns.length) return;

    const current = localStorage.getItem('site-theme') || 'normal';
    document.documentElement.setAttribute('data-theme', current === 'normal' ? '' : current);
    btns.forEach(btn => {
      btn.classList.toggle('active', btn.getAttribute('data-theme-value') === current);
    });

    btns.forEach(btn => {
      btn.addEventListener('click', () => {
        const theme = btn.getAttribute('data-theme-value');
        if (theme === 'normal') {
          document.documentElement.removeAttribute('data-theme');
          localStorage.removeItem('site-theme');
        } else {
          document.documentElement.setAttribute('data-theme', theme);
          localStorage.setItem('site-theme', theme);
        }
        btns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
      });
    });
  }

  document.addEventListener('astro:page-load', () => { initNav(); initTheme(); });
  initNav();
  initTheme();
</script>

<style is:global>
  .retro-nav {
    background: linear-gradient(180deg, #0d0221 0%, #1a0a2e 100%);
    border-bottom: 3px solid var(--color-primary);
    padding: 0.5rem 1rem;
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .retro-nav .nav-container {
    max-width: 100%;
    margin: 0 auto;
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    gap: 0.5rem;
  }

  .retro-nav .nav-logo {
    font-family: var(--font-heading);
    font-size: 0.95rem;
    color: var(--color-secondary);
    text-decoration: none;
    white-space: nowrap;
    flex-shrink: 0;
    margin-right: 0.5rem;
    letter-spacing: 1px;
  }

  .retro-nav .nav-logo:hover {
    color: var(--color-primary);
    text-decoration: none;
  }

  .retro-nav .nav-links {
    display: flex;
    flex-wrap: nowrap;
    gap: 0.3rem;
    align-items: center;
    overflow-x: auto;
    min-width: 0;
    -webkit-overflow-scrolling: touch;
  }

  .retro-nav .nav-links::-webkit-scrollbar {
    display: none;
  }

  .retro-nav .nav-link {
    padding: 0.3rem 0.5rem;
    font-size: 0.8rem;
    font-family: var(--font-main);
    color: var(--color-text);
    text-decoration: none;
    border: 1px solid transparent;
    transition: all 0.2s;
    white-space: nowrap;
    letter-spacing: 0.5px;
    flex-shrink: 0;
  }

  .retro-nav .nav-link:hover {
    color: var(--color-secondary);
    border-color: var(--color-secondary);
    text-decoration: none;
  }

  .retro-nav .nav-link.active {
    background: var(--color-primary);
    color: white;
    border-color: var(--color-primary);
  }

  .retro-nav .lang-switch {
    margin-left: 0.3rem;
    border: 2px dashed var(--color-accent) !important;
    color: var(--color-accent) !important;
  }

  .retro-nav .hamburger {
    display: none;
    background: none;
    border: 2px dashed var(--color-card-border);
    padding: 0.5rem;
    cursor: pointer;
    flex-direction: column;
    gap: 4px;
    align-items: center;
    justify-content: center;
    width: 2.2rem;
    height: 2.2rem;
    flex-shrink: 0;
  }

  .retro-nav .hamburger-line {
    display: block;
    width: 1.1rem;
    height: 2px;
    background: var(--color-secondary);
    transition: transform 0.3s, opacity 0.3s;
  }

  .retro-nav .hamburger.open .hamburger-line:nth-child(1) {
    transform: translateY(6px) rotate(45deg);
  }

  .retro-nav .hamburger.open .hamburger-line:nth-child(2) {
    opacity: 0;
  }

  .retro-nav .hamburger.open .hamburger-line:nth-child(3) {
    transform: translateY(-6px) rotate(-45deg);
  }

  .retro-nav .nav-overlay {
    display: none;
  }

  @media (max-width: 900px) {
    .retro-nav .nav-container {
      gap: 0.3rem 0.5rem;
    }

    .retro-nav .nav-link {
      font-size: 0.7rem;
      padding: 0.25rem 0.4rem;
    }

    .retro-nav .nav-logo {
      font-size: 0.75rem;
    }

    .retro-nav .theme-switch {
      font-size: 0.6rem;
      gap: 0.25rem;
      padding: 0.2rem 0.4rem;
    }

    .retro-nav .theme-switch-btn {
      font-size: 0.55rem;
      padding: 0.1rem 0.3rem;
    }
  }

  @media (max-width: 600px) {
    .retro-nav {
      padding: 0.4rem 0.5rem;
    }

    .retro-nav .nav-container {
      flex-wrap: nowrap;
    }

    .retro-nav .hamburger {
      display: flex;
    }

    .retro-nav .nav-logo {
      font-size: 0.75rem;
    }

    .retro-nav .hamburger {
      margin-left: auto;
    }

    .retro-nav .nav-links {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: #0d0221;
      border-bottom: 3px solid var(--color-primary);
      flex-direction: column;
      padding: 0.5rem 0;
      z-index: 200;
      max-height: calc(100vh - 3rem);
      overflow-y: auto;
    }

    .retro-nav .nav-links.open {
      display: flex;
    }

    .retro-nav .nav-link {
      font-size: 0.85rem;
      padding: 0.7rem 1.2rem;
      border: none;
      border-left: 3px solid transparent;
    }

    .retro-nav .nav-link:hover {
      border-left-color: var(--color-secondary);
    }

    .retro-nav .nav-link.active {
      border-left-color: var(--color-primary);
      background: rgba(255, 107, 53, 0.15);
    }

    .retro-nav .theme-switch {
      margin: 0.5rem 1.2rem;
      padding: 0.4rem 0.6rem;
      font-size: 0.7rem;
      justify-content: center;
    }

    .retro-nav .theme-switch-btn {
      font-size: 0.65rem;
      padding: 0.15rem 0.5rem;
    }

    .retro-nav .nav-overlay.open {
      display: block;
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 150;
    }
  }
</style>
